Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"F1", "[", 
    RowBox[{"\[Beta]_", ",", "\[Lambda]_", ",", "m_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{" ", "\[Beta]"}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Beta]", "-", 
          RowBox[{
           FractionBox["1", "2"], " ", 
           RowBox[{"Log", "[", 
            FractionBox[
             RowBox[{"\[Beta]", "+", "1"}], 
             RowBox[{"1", "-", "\[Beta]"}]], "]"}]}]}], ")"}], " ", 
        RowBox[{"Log", "[", 
         FractionBox["m", "\[Lambda]"], "]"}]}], "+", 
       RowBox[{
        FractionBox[
         RowBox[{"3", "+", 
          SqrtBox[
           RowBox[{"1", "-", 
            SuperscriptBox["\[Beta]", "2"]}]]}], "8"], 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"1", "+", "\[Beta]"}], 
          RowBox[{"1", "-", "\[Beta]"}]], "]"}]}], "-", 
       RowBox[{
        FractionBox["1", "8"], 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"1", "+", "\[Beta]"}], 
          RowBox[{"1", "-", "\[Beta]"}]], "]"}], 
        RowBox[{"Log", "[", 
         RowBox[{"2", " ", 
          FractionBox[
           RowBox[{"1", "+", 
            SqrtBox[
             RowBox[{"1", "-", 
              SuperscriptBox["\[Beta]", "2"]}]]}], 
           SqrtBox[
            RowBox[{"1", "-", 
             SuperscriptBox["\[Beta]", "2"]}]]]}], "]"}]}], "-", 
       RowBox[{
        FractionBox["1", "2"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"PolyLog", "[", 
           RowBox[{"2", ",", 
            FractionBox[
             RowBox[{"\[Beta]", "-", "1", "+", 
              SqrtBox[
               RowBox[{"1", "-", 
                SuperscriptBox["\[Beta]", "2"]}]]}], 
             RowBox[{"2", "\[Beta]"}]]}], "]"}], "-", 
          RowBox[{"PolyLog", "[", 
           RowBox[{"2", ",", 
            FractionBox[
             RowBox[{"\[Beta]", "+", "1", "-", 
              SqrtBox[
               RowBox[{"1", "-", 
                SuperscriptBox["\[Beta]", "2"]}]]}], 
             RowBox[{"2", "\[Beta]"}]]}], "]"}]}], ")"}]}]}], ")"}]}], "-", 
    "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F2", "[", "\[Beta]_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     SqrtBox[
      RowBox[{"1", "-", 
       SuperscriptBox["\[Beta]", "2"]}]], 
     RowBox[{"4", " ", "\[Beta]"}]], " ", 
    RowBox[{"Log", "[", 
     FractionBox[
      RowBox[{"\[Beta]", "+", "1"}], 
      RowBox[{"1", "-", "\[Beta]"}]], "]"}]}]}], ";"}]}], "Input",
