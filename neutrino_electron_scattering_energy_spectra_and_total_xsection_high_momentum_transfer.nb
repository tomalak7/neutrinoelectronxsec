Cell[TextData[{
 StyleBox["Total cross section \[Sigma](\[Omega]) is given in units ",
  FontSize->24],
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["10", 
    RowBox[{"-", "42"}]], " ", 
   SuperscriptBox["cm", "2"]}]],
  FontSize->24,ExpressionUUID->"3c37af2b-e424-4bdc-acb6-c8c5bdc61190"],
 StyleBox[" as a function of the neutrino energy \[Omega].\nEnergy spectra  ",
  
  FontSize->24],
 Cell[BoxData[
  FormBox[
   FractionBox["d\[Sigma]", "dE"], TraditionalForm]],
  FontSize->24,ExpressionUUID->"8182808e-d2b7-4993-98c2-2292ac488dc5"],
 StyleBox["(X,\[Omega]) are given in units ",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SuperscriptBox["10", 
      RowBox[{"-", "42"}]], " ", 
     SuperscriptBox["cm", "2"], 
     SuperscriptBox["GeV", 
      RowBox[{"-", "1"}]]}]}], TraditionalForm]],
  FontSize->24,ExpressionUUID->"e4db115d-949a-4b72-8d7c-3c2e86622b3c"],
 " ",
 StyleBox["as functions of the neutrino energy \[Omega] and X = 2m (1-",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["E", "\[Omega]"],
    FontSize->24], TraditionalForm]],ExpressionUUID->
  "b44a294f-2fa6-4963-a2fb-b4331ba5c50e"],
 StyleBox[").\nm is the electron mass. \nE stands for the electron or \
electromagnetic (sum of electron and photon) energies. \nNLO = 1 for the \
total result. \nNLO = 0 for the tree-level contribution. \nThe script is \
based on arXiv:1907.03379.",
  FontSize->24]
}], "Text",
