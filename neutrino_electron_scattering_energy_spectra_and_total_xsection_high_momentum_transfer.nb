       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"Log", "[", 
         FractionBox[
          RowBox[{"1", "+", "\[Beta]"}], 
          RowBox[{"1", "-", "\[Beta]"}]], "]"}]}]}], ")"}], " ", 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"2", " ", "\[Epsilon]"}], "\[Lambda]"], "]"}]}], "+", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "\[Beta]"}]], 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{"1", "+", "\[Beta]"}], 
       RowBox[{"1", "-", "\[Beta]"}]], "]"}], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"Log", "[", 
        RowBox[{
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["\[Beta]", "2"]}]], 
         FractionBox[
          RowBox[{"1", "+", "\[Beta]"}], 
          RowBox[{"4", " ", 
           SuperscriptBox["\[Beta]", "2"]}]]}], "]"}]}], ")"}]}], "+", 
    "1"}]}], ";"}]], "Input",
