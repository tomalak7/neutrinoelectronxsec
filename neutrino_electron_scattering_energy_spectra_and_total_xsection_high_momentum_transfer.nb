Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"IL0", "[", 
    RowBox[{"m_", ",", "\[Omega]_", ",", "\[Omega]p_"}], "]"}], ":=", "1"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IR0", "[", 
    RowBox[{"m_", ",", "\[Omega]_", ",", "\[Omega]p_"}], "]"}], ":=", 
   FractionBox[
    SuperscriptBox["\[Omega]p", "2"], 
    SuperscriptBox["\[Omega]", "2"]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ILR0", "[", 
    RowBox[{"m_", ",", "\[Omega]_", ",", "\[Omega]p_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["m", "\[Omega]"]}], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox["\[Omega]p", "\[Omega]"]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"I4", "[", 
    RowBox[{"m_", ",", "\[Omega]_", ",", "\[Omega]p_"}], "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox["\[Omega]p", "\[Omega]"]}], ")"}], "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"I5", "[", 
    RowBox[{"m_", ",", "\[Omega]_", ",", "\[Omega]p_"}], "]"}], ":=", 
   RowBox[{"1", "-", 
    FractionBox["\[Omega]p", "\[Omega]"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"IXX", "[", 
    RowBox[{"m_", ",", "\[Omega]_", ",", "\[Omega]p_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", 
       RowBox[{"IL0", "[", 
        RowBox[{"m", ",", "\[Omega]", ",", "\[Omega]p"}], "]"}]}], "+", 
      RowBox[{"IR0", "[", 
       RowBox[{"m", ",", "\[Omega]", ",", "\[Omega]p"}], "]"}], "+", 
      RowBox[{"2", 
       RowBox[{"ILR0", "[", 
        RowBox[{"m", ",", "\[Omega]", ",", "\[Omega]p"}], "]"}]}], "-", 
      RowBox[{"I4", "[", 
       RowBox[{"m", ",", "\[Omega]", ",", "\[Omega]p"}], "]"}], "-", 
      RowBox[{"2", 
       RowBox[{"I5", "[", 
        RowBox[{"m", ",", "\[Omega]", ",", "\[Omega]p"}], "]"}]}]}], 
     ")"}]}]}], ";"}]}], "Input",
