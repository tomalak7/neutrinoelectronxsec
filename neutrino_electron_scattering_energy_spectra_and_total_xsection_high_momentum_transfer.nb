 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]soft", "[", 
    RowBox[{"\[Beta]_", ",", "\[Lambda]_", ",", "\[Epsilon]_"}], "]"}], ":=", 
   
   RowBox[{
    RowBox[{
     FractionBox["1", "\[Beta]"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"PolyLog", "[", 
        RowBox[{"2", ",", 
         FractionBox[
