Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]electronspectrumIR2", "[", 
    RowBox[{"\[Beta]_", ",", "m_", ",", "\[Omega]_", ",", "\[Omega]p_"}], 
    "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Rho]", "=", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["\[Beta]", "2"]}]]}], ",", 
       RowBox[{"cos\[Delta]", "=", 
