Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPi]", "[", 
    RowBox[{"m_", ",", "Q2_", ",", "\[Mu]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "3"], 
     RowBox[{"Log", "[", 
      FractionBox[
       SuperscriptBox["\[Mu]", "2"], 
       SuperscriptBox["m", "2"]], "]"}]}], "+", 
    FractionBox["5", "9"], "-", 
    FractionBox[
     RowBox[{"4", 
      SuperscriptBox["m", "2"]}], 
     RowBox[{"3", "Q2"}]], "+", 
    RowBox[{
     FractionBox["1", "3"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       FractionBox[
        RowBox[{"2", 
         SuperscriptBox["m", "2"]}], "Q2"]}], ")"}], 
     SqrtBox[
      RowBox[{"1", "+", 
       FractionBox[
        RowBox[{"4", 
         SuperscriptBox["m", "2"]}], "Q2"]}]], 
     RowBox[{"Log", "[", 
      FractionBox[
       RowBox[{
        SqrtBox[
         RowBox[{"1", "+", 
          FractionBox[
           RowBox[{"4", 
            SuperscriptBox["m", "2"]}], "Q2"]}]], "-", "1"}], 
       RowBox[{
        SqrtBox[
         RowBox[{"1", "+", 
          FractionBox[
           RowBox[{"4", 
            SuperscriptBox["m", "2"]}], "Q2"]}]], "+", "1"}]], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"V1", "[", "r_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rp", "=", 
        RowBox[{
         SqrtBox[
          RowBox[{"1", "-", "r"}]], "+", 
         SqrtBox[
          RowBox[{"-", "r"}]]}]}], ",", 
       RowBox[{"rm", "=", 
        RowBox[{
         SqrtBox[
          RowBox[{"1", "-", "r"}]], "-", 
         SqrtBox[
          RowBox[{"-", "r"}]]}]}], ",", 
       RowBox[{"g", "=", 
        RowBox[{"Log", "[", 
         RowBox[{"rp", "-", "rm"}], "]"}]}], ",", 
       RowBox[{"h", "=", 
        RowBox[{"Log", "[", 
         RowBox[{"rp", "+", "rm"}], "]"}]}], ",", 
       RowBox[{"f", "=", 
        RowBox[{"Log", "[", "rp", "]"}]}]}], "}"}], ",", 
     RowBox[{"Re", "[", 
      RowBox[{
       RowBox[{"4", 
        RowBox[{"(", 
         RowBox[{"r", "-", 
          FractionBox["1", 
           RowBox[{"4", "r"}]]}], ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", 
           RowBox[{"PolyLog", "[", 
            RowBox[{"3", ",", 
             SuperscriptBox["rm", "2"]}], "]"}]}], "-", 
          RowBox[{"PolyLog", "[", 
           RowBox[{"3", ",", 
            SuperscriptBox["rm", "4"]}], "]"}], "+", 
          RowBox[{
           FractionBox["8", "3"], "f", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"PolyLog", "[", 
              RowBox[{"2", ",", 
               SuperscriptBox["rm", "2"]}], "]"}], "-", 
             RowBox[{"PolyLog", "[", 
              RowBox[{"2", ",", 
               SuperscriptBox["rm", "4"]}], "]"}]}], ")"}]}], "+", 
          RowBox[{"4", 
           SuperscriptBox["f", "2"], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", "f"}], "+", 
             FractionBox["g", "3"], "+", 
             RowBox[{
              FractionBox["2", "3"], "h"}]}], ")"}]}]}], ")"}]}], "+", 
       RowBox[{
        SqrtBox[
         RowBox[{"1", "-", 
          FractionBox["1", "r"]}]], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["8", "3"], 
           RowBox[{"(", 
            RowBox[{"r", "+", 
             FractionBox["1", "2"]}], ")"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"PolyLog", "[", 
              RowBox[{"2", ",", 
               SuperscriptBox["rm", "2"]}], "]"}], "-", 
             RowBox[{"PolyLog", "[", 
              RowBox[{"2", ",", 
               SuperscriptBox["rm", "4"]}], "]"}], "+", 
             RowBox[{"f", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "3"}], "f"}], "+", 
                RowBox[{"2", "g"}], "+", 
                RowBox[{"4", "h"}]}], ")"}]}]}], ")"}]}], "-", 
          RowBox[{"2", 
           RowBox[{"(", 
            RowBox[{"r", "+", 
             FractionBox["3", "2"]}], ")"}], "f"}]}], ")"}]}], "-", 
       RowBox[{"8", 
        RowBox[{"(", 
         RowBox[{"r", "-", 
          FractionBox["1", "6"], "-", 
          FractionBox["7", 
           RowBox[{"48", "r"}]]}], ")"}], 
        SuperscriptBox["f", "2"]}], "+", 
       FractionBox["13", "6"], "+", 
       FractionBox[
        RowBox[{"Zeta", "[", "3", "]"}], "r"]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
